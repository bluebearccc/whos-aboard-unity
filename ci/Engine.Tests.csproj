<!-- Chạy test engine bằng .NET thường (không cần Unity / license) — dùng cho CI.
     Engine phải là C# thuần nên biên dịch được ở đây; LangVersion 9 = bản C# của Unity,
     lỡ dùng cú pháp mới hơn thì CI báo lỗi ngay. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/Scripts/Engine/**/*.cs" />
    <Compile Include="../Assets/Tests/EditMode/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
